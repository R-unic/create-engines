{
  "multipart": [
    {
      "apply": {
        "model": "create_engines:block/engine_casing/block"
      },
      "when": {
        "encased": "true"
      }
    },
    {
      "apply": {
        "model": "create_engines:block/heat_exchanger/core"
      },
      "when": {
        "encased": "false"
      }
    },
    {
      "apply": {
        "model": "create_engines:block/heat_exchanger/arm_down"
      },
      "when": {
        "down": "true",
        "encased": "false"
      }
    },
    {
      "apply": {
        "model": "create_engines:block/heat_exchanger/arm_up"
      },
      "when": {
        "encased": "false",
        "up": "true"
      }
    },
    {
      "apply": {
        "model": "create_engines:block/heat_exchanger/arm_north"
      },
      "when": {
        "encased": "false",
        "north": "true"
      }
    },
    {
      "apply": {
        "model": "create_engines:block/heat_exchanger/arm_south"
      },
      "when": {
        "encased": "false",
        "south": "true"
      }
    },
    {
      "apply": {
        "model": "create_engines:block/heat_exchanger/arm_west"
      },
      "when": {
        "encased": "false",
        "west": "true"
      }
    },
    {
      "apply": {
        "model": "create_engines:block/heat_exchanger/arm_east"
      },
      "when": {
        "east": "true",
        "encased": "false"
      }
    },
    {
      "apply": {
        "model": "create_engines:block/heat_exchanger/glow_kindled"
      },
      "when": {
        "blaze": "kindled"
      }
    },
    {
      "apply": {
        "model": "create_engines:block/heat_exchanger/glow_seething"
      },
      "when": {
        "blaze": "seething"
      }
    }
  ]
}